#!/bin/sh
# PER-REPO pre-push -- the strict local backstop: tree + EVERY commit reachable from any ref
# (blobs, messages, author/committer identity).
#
# Full history is the right scope HERE and only here: this is a repo we own and have already cleaned,
# so it stays green, and a regression anywhere in it is a real finding. The machine-wide hook cannot
# do this -- it also runs in forks, whose upstream history holds thousands of other people's
# mailboxes -- so it checks the push range instead.
#
# This is the boundary the 2026-07 leaks crossed. Each was "fixed" by editing the file, so the tree
# was clean at push time and the commit that introduced the PII went to GitHub anyway. A guard that
# only looked at the tree would have waved every single one of them through.
#
# It is also where an agent fools itself: `pytest -q && git push` reports the PUSH's exit code, so a
# failing test still ships. A hook cannot be masked that way.
#
# Output is captured, not piped -- see the note in pre-commit. A verdict a caller's `| head` can
# destroy is not a verdict. Belt and braces: the same scan runs in CI (.github/workflows/
# pii-guard.yml), which no local shell quirk and no --no-verify can reach.
ROOT="$(git rev-parse --show-toplevel)"
GUARD="$ROOT/tools/pii_guard.py"
BOUNDARY="$ROOT/tools/data_boundary.py"
# FAIL CLOSED on a missing guard, same as the interpreter probe below and for the same reason:
# `|| exit 0` meant deleting one file silently switched push protection off and printed nothing,
# so a disarmed hook and a passing hook produced identical output. Demonstrated 2026-08-30 by
# removing tools/pii_guard.py and watching a push carrying an address exit 0 in silence.
if [ ! -f "$GUARD" ]; then
  echo "BLOCKED: $GUARD is missing, so nothing is checking this push."
  echo "Restore it with the pii-guard installer rather than pushing blind."
  exit 1
fi
# A MISSING INTERPRETER MUST FAIL CLOSED. This used to be
#   PY=$(command -v python || command -v python3 || command -v py) || exit 0
# which means: on any machine where python does not resolve, every gate below silently does nothing
# and the operation sails through looking guarded. That is not hypothetical here -- a Windows PATH
# that resolved `python` only to the WindowsApps App Execution Alias has already burned this
# operator, and a stub RESOLVES: `command -v` finds it, it just cannot run anything. So probe the
# interpreter, never infer from the fact that a name resolved.
PY=""
for _cand in python python3 py; do
  _bin=$(command -v "$_cand" 2>/dev/null) || continue
  "$_bin" -c "import sys" >/dev/null 2>&1 || continue
  PY=$_bin
  break
done
if [ -z "$PY" ]; then
  echo "BLOCKED: no WORKING python interpreter found (tried python, python3, py)."
  echo "The guards cannot run, so nothing at all would be checking this."
  echo "On Windows this is usually PATH resolving only the WindowsApps stub, which resolves but"
  echo "cannot execute. Install a real python or put it ahead of WindowsApps on PATH."
  exit 1
fi

# Printed on every run. This hook is the one that runs --history, so it is the ONLY place the
# HISTORY-DEBT lines can ever be seen. Swallowing a passing run here would make the entire debt
# ledger invisible, which is exactly how debt stops being debt and becomes furniture.
out=$("$PY" "$GUARD" --tree --history 2>&1)
rc=$?
[ -n "$out" ] && printf '%s\n' "$out"
if [ "$rc" -ne 0 ]; then
  echo ""
  echo "push BLOCKED by pii_guard: real private data would become public and permanent."
  echo "A file edit is NOT a fix once it is in a commit -- rewrite the history (git filter-repo)."
  exit 1
fi

# The DATA BOUNDARY (see the note in pre-commit). Checked again at the push boundary, because this
# is the last moment anything is still private -- and because a commit can arrive here without ever
# passing pre-commit (a merge, a cherry-pick, a rebase, another clone, --no-verify).
if [ ! -f "$BOUNDARY" ]; then
  echo "BLOCKED: $BOUNDARY is missing, so the data boundary is not being checked."
  echo "Restore it with the pii-guard installer rather than pushing blind."
  exit 1
fi
out=$("$PY" "$BOUNDARY" 2>&1)
rc=$?
if [ "$rc" -ne 0 ]; then
  printf '%s\n' "$out"
  echo ""
  echo "push BLOCKED by data_boundary: this repo is not an uninitialized tool."
  echo "Real-run output would become public and permanent. Move it to the private store."
  exit 1
fi

# --- SEMANTIC layer (operator machine only) ----------------------------------------------------
# WHY IT IS HERE AND NOT ONLY IN THE MACHINE-WIDE HOOK. Every repo that vendors these hooks sets
# repo-level core.hooksPath=.githooks, which SHADOWS the machine-wide hook entirely. The identity
# assertion was duplicated into both places for exactly that reason; the semantic gate never was,
# so the one layer that reads MEANING rather than shape ran
# on none of the repos that matter. On 2026-08-30 a commit MESSAGE carried something only this
# layer could have caught and every structural check passed it clean. That is not a defect in the
# structural checks: they match shapes, and the class this layer exists for has no shape to match.
#
# NOT vendored, deliberately: semantic_gate.py and llmcall live under the operator's HOME and are
# not part of this repo. An outside contributor does not have them, this block is a no-op for them,
# and the structural gate above has already run fail-closed for everyone.
#
# ADVISORY BY CONSTRUCTION: semantic_gate exits 0 when llmcall is down, when the push adds no prose,
# and when the verdict is unsure. It blocks only on a confident finding.
# Referenced through the ~/.local/bin adapter on purpose: this file is VENDORED into public repos,
# and spelling out the guard's own install directory here would make every one of them fail their
# own pii_guard, which whitelists only a couple of config subdirectories and nothing else under
# that tree. Caught the honest way, by staging this hook and running the guard on it: the first
# attempt named the script, the second still tripped on a comment that merely quoted the whitelist.
# The adapter lives outside every worktree and is the single place that path is written down, and
# it is absent on a contributor machine, which is exactly when this layer should be a no-op.
SEM="$HOME/.local/bin/semantic-gate"
if [ -f "$SEM" ]; then
  z="0000000000000000000000000000000000000000"
  semrc=0
  while read -r _lref lsha _rref rsha; do
    [ "$lsha" = "$z" ] && continue
    if [ "$rsha" = "$z" ] || ! git cat-file -e "${rsha}^{commit}" 2>/dev/null ||
       ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
      srange="$lsha --not --remotes"
    else
      srange="$rsha..$lsha"
    fi
    so=$("$SEM" --repo "$ROOT" --range "$srange" 2>&1) || semrc=1
    [ -n "$so" ] && printf '%s\n' "$so"
  done
  [ "$semrc" -ne 0 ] && exit 1
fi
exit 0
