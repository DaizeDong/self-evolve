#!/bin/sh
# Tracked shim. core.hooksPath points at .githooks, never straight at guards/hooks: a clone without
# --recursive leaves guards/ present and empty, and git would then run no hook at all and exit 0.
# So a missing or empty kit hook is a block with a sentence, never a quiet pass.
_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
_REAL="$_ROOT/guards/hooks/pre-commit"
if [ ! -s "$_REAL" ]; then
  echo "BLOCKED: guards/hooks/pre-commit is missing or empty, so nothing checked this commit." >&2
  echo "  The guards submodule is not checked out. Fix it, do not bypass it:" >&2
  echo "      git submodule update --init --recursive" >&2
  exit 1
fi
exec sh "$_REAL" "$@"
