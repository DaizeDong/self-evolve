// Public TOOL documentation. Render with: python docs/diagrams/render.py
digraph workflow {
  graph [rankdir=LR, bgcolor="white", pad="0.16", nodesep="0.22", ranksep="0.30", splines=polyline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=16, fontcolor="#0f172a", penwidth=1.6, margin="0.12,0.10", fillcolor="#f1f5f9", color="#475569"];
  edge [fontname="Microsoft YaHei", fontsize=12, fontcolor="#475569", color="#64748b", penwidth=1.3, arrowsize=0.7];

  contract [label="冻结\n评测契约", fillcolor="#eef2ff", color="#6366f1"];
  parent [label="选择父代\n并诊断"];
  patch [label="范围内提案\n+ 隔离修改"];
  evaluate [label="配对评测\n+ 代码裁决", fillcolor="#fef9c3", color="#ca8a04"];
  accept [label="ACCEPT\n归档候选快照", fillcolor="#dcfce7", color="#16a34a"];
  reject [label="REJECT\n保留或恢复父代", fillcolor="#fff1f2", color="#e11d48"];
  review [label=<<FONT FACE="Arial"><B>PAUSE_FOR_HUMAN</B></FONT><BR/><FONT POINT-SIZE="14">记录待审动作与原因</FONT>>, fontsize=14, fillcolor="#fef9c3", color="#ca8a04"];
  next [label="进入下一轮？\n轮数与熔断限制", fillcolor="#fef9c3", color="#ca8a04"];
  finish [label="结束本次调用\n保留状态与原因", fillcolor="#e0f2fe", color="#0284c7"];

  { rank=same; contract; parent; patch; }
  contract -> parent -> patch;
  patch -> evaluate;
  evaluate -> accept [color="#16a34a"];
  evaluate -> reject [color="#e11d48"];
  evaluate -> review [color="#ca8a04"];
  evaluate -> next [label="CONTINUE（仅 B）", style=dashed];
  { rank=same; accept; reject; review; }
  accept -> reject -> review [style=invis, weight=5];
  accept -> next;
  reject -> next;
  review -> next;
  next:n -> parent:e [label="是：下一轮", constraint=false];
  next -> finish [label="否"];
}
