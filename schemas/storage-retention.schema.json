{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed private storage retirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "protected_paths",
    "retirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "protected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason",
          "completed",
          "dependencies_released"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "completed": {
            "const": true
          },
          "dependencies_released": {
            "const": true
          }
        }
      }
    }
  }
}
